const KEYS=["opa","oca","cch","odp"];
const FIELDS=["hotspot","exon","cnv","fusion","loh"];
const LABEL={hotspot:["Hotspot","hot"],exon:["Full coding","exon"],cnv:["CNV","cnv"],fusion:["Fusion","fus"],loh:["LOH","loh"]};

for(const k of KEYS){for(const f of FIELDS){
  P[k][f]=new Set((P[k][f]||"").split(/[\s,]+/).filter(Boolean));
}}
P.odp.cnv=P.odp.exon;
P.odp.loh=P.odp.exon;

const ALL=new Set();
for(const k of KEYS)for(const f of FIELDS)for(const g of P[k][f])ALL.add(g);
const SORTED=[...ALL].sort();

const q=document.getElementById("q"), out=document.getElementById("out");

function render(gene){
  const hits=KEYS.filter(k=>FIELDS.some(f=>P[k][f].has(gene)));
  let html='<p class="gene-title">'+gene+'</p>';
  html+='<p class="verdict">'+(hits.length?"Covered by "+hits.length+" of 4 panels.":"Not included in any of the four panels.")+'</p>';
  for(const k of KEYS){
    const found=FIELDS.filter(f=>P[k][f].has(gene));
    html+='<div class="panel '+(found.length?"hit-"+k:"miss")+'">'
      +'<p class="pname"><span>'+P[k].name+'</span><span class="pcode">'+P[k].code+'</span></p>'
      +(found.length
        ? '<div class="tags">'+found.map(f=>'<span class="tag '+LABEL[f][1]+'">'+LABEL[f][0]+'</span>').join("")+'</div>'
        : '<span class="none">not included</span>')
      +'</div>';
  }
  out.innerHTML=html;
}

function suggest(term){
  const m=SORTED.filter(g=>g.indexOf(term)===0).slice(0,16);
  if(!m.length){out.innerHTML='<p class="empty">No gene matches "'+term+'" in OPA, OCA, Childhood or OncoDEEP.</p>';return;}
  out.innerHTML='<ul class="suggest">'+m.map(g=>'<li><button data-g="'+g+'">'+g+'</button></li>').join("")+'</ul>';
  out.querySelectorAll("button").forEach(b=>b.onclick=function(){q.value=b.dataset.g;render(b.dataset.g);});
}

q.addEventListener("input",function(){
  const t=q.value.trim().toUpperCase();
  if(!t){out.innerHTML="";return;}
  if(ALL.has(t))render(t); else suggest(t);
});
q.addEventListener("keydown",function(e){
  if(e.key!=="Enter")return;
  const t=q.value.trim().toUpperCase();
  const first=out.querySelector("button");
  if(ALL.has(t))render(t); else if(first){q.value=first.dataset.g;render(first.dataset.g);}
});
</script>
</body>
</html>
